# ── Adresses ─────────────────────────────────────────────────────
PORT_BACKEND=8100
BACKEND_URL=http://localhost:8100
PORT_FRONTEND=4215
FRONTEND_URL=http://localhost:4215

# ── Base de données ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devdb
DB_SCHEMA=oauth_hub
DB_USER=devuser
DB_PASSWORD=CHANGE_ME

# ── Django ───────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=*

# ── Reverse proxy (Caddy) ────────────────────────────────────────
SCRIPT_NAME=/oauth-hub-api

# ── SSO Keycloak ─────────────────────────────────────────────────
KEYCLOAK_CLIENT_ID=oauth-hub
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/ssolab
# Client public (SPA Angular) — Keycloak → Clients → oauth-hub → Access type : Public
# Valid redirect URIs : http://localhost:4215/*

# ── URLs (propagées automatiquement par reset_url.sh) ────────────
PORT_KEYCLOAK=8080
SERVER_URL_LAN=http://192.168.1.X
SERVER_URL_WAN=http://VOTRE_IP_WAN
KEYCLOAK_URL=http://192.168.1.X:8080
KEYCLOAK_PUBLIC_URL=http://VOTRE_IP_WAN:8080

# ── HTTPS / Caddy ─────────────────────────────────────────────────────────────
DOMAIN=CHANGE_ME

# ── Coffre OAuth ──────────────────────────────────────────────────────────────
# Clé Fernet chiffrant les client_secret des sites ET les jetons amont des
# utilisateurs. Générée par scripts/init-secrets.sh — ne jamais commiter la vraie
# valeur. En changer rend TOUT le coffre illisible (aucune reprise automatique).
OAUTH_HUB_ENCRYPTION_KEY=CHANGE_ME
# Groupes autorisés à déposer/modifier les identifiants d'un site.
OAUTH_HUB_ADMIN_GROUPS=developers
# Clients Keycloak autorisés à demander les jetons amont de leurs utilisateurs.
# ⚠ Chaque client ajouté ici peut agir sur les sites externes au nom de
# l'utilisateur : à tenir app par app, jamais ouvert au realm.
KEYCLOAK_TRUSTED_CLIENTS=oauth-hub

# Aucun identifiant de site (client_id/client_secret GitHub, GitLab…) ne figure
# ici : ils vivent chiffrés en base, déposés par un dev depuis l'interface.
